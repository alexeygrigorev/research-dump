# Copy to .env. Never commit the real file. Use a NEW bot, not an existing assistant token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=0
USE_CODEX=0
# Optional Mini App: HTTPS URL to local `python -m threadscout serve`, via your tunnel.
TELEGRAM_WEBAPP_URL=
# Do not set these flags just to bypass a check. Approval must cover the actual use.
REDDIT_APPROVED=0
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=ThreadScout/0.1 by /u/REPLACE_ME
REDDIT_LLM_APPROVED=0
# Optional database location:
# THREADSCOUT_DB=/absolute/path/to/private/threadscout.sqlite3
